<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Testcontainers" />
    <ProjectReference Include="../../src/Parchwell.Verifier/Parchwell.Verifier.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../fixtures/verifier-v1/**/*">
      <Link>fixtures/verifier-v1/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$(ParchwellVerifierMutationOnly)' == 'true'">
    <Compile Remove="Component/**/*.cs;Support/ComponentEvidenceBuilder.cs" />
  </ItemGroup>
</Project>
