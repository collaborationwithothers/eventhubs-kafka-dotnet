{
  "stryker-config": {
    "project": "Parchwell.Verifier.csproj",
    "test-runner": "mtp",
    "configuration": "Release",
    "target-framework": "net10.0",
    "reporters": [
      "json",
      "html",
      "progress"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 60
    },
    "mutate": [
      "VerifyRun/Judgement/*.cs",
      "VerifyRun/Window/*.cs",
      "VerifyRun/A01/A01EvidenceRecorder.cs",
      "ProbeGate/ProbeGateEvaluator.cs"
    ]
  }
}
