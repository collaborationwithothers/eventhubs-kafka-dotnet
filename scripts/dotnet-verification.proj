<Project>
  <UsingTask TaskName="ValidateXunitReport" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Report ParameterType="System.String" Required="true" />
      <ExpectedAssembly ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Xml" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Method" Language="cs"><![CDATA[
      public override bool Execute()
      {
        try
        {
            if (!File.Exists(Report)) throw new InvalidDataException("Missing test report: " + Report);
            var settings = new XmlReaderSettings { DtdProcessing = DtdProcessing.Prohibit, XmlResolver = null };
            XDocument document;
            using (var reader = XmlReader.Create(Report, settings)) document = XDocument.Load(reader);
            if (document.Root == null || document.Root.Name != "assemblies") throw new InvalidDataException("Unexpected xUnit report root.");
            var assemblies = document.Root.Elements("assembly").ToArray();
            if (assemblies.Length != 1) throw new InvalidDataException("Expected exactly one test assembly.");
            var assembly = assemblies[0];
            if (Path.GetFileNameWithoutExtension((string)assembly.Attribute("name")) != ExpectedAssembly)
                throw new InvalidDataException("Report does not belong to " + ExpectedAssembly + ".");
            Func<XElement, string, int> count = (element, field) =>
            {
                int value;
                if (!int.TryParse((string)element.Attribute(field), out value) || value < 0)
                    throw new InvalidDataException("Missing or invalid result count: " + field);
                return value;
            };
            var tests = assembly.Descendants("test").ToArray();
            var passed = count(assembly, "passed");
            if (passed <= 0 || count(assembly, "failed") != 0 || count(assembly, "skipped") != 0
                || count(assembly, "not-run") != 0 || count(assembly, "errors") != 0)
                throw new InvalidDataException("Report must contain passing tests and zero failures, skips, not-run tests or errors.");
            if (count(assembly, "total") != passed || tests.Length != passed || tests.Any(test => (string)test.Attribute("result") != "Pass"))
                throw new InvalidDataException("Assembly totals disagree with individual test results.");
            if (assembly.Descendants("error").Any() || assembly.Descendants("failure").Any())
                throw new InvalidDataException("Report contains runner errors or test failures.");
            var collections = assembly.Elements("collection").ToArray();
            if (collections.Length == 0 || collections.Sum(collection => count(collection, "total")) != passed)
                throw new InvalidDataException("Collection totals disagree with assembly total.");
            foreach (var collection in collections)
            {
                var collectionTests = collection.Elements("test").ToArray();
                if (count(collection, "passed") != collectionTests.Length || count(collection, "total") != collectionTests.Length
                    || count(collection, "failed") != 0 || count(collection, "skipped") != 0 || count(collection, "not-run") != 0)
                    throw new InvalidDataException("Collection summary disagrees with individual results.");
            }
            Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High, ExpectedAssembly + ": " + passed + " passed; checked report.");
            return true;
        }
        catch (Exception exception)
        {
            Log.LogError("Test report rejected: " + exception.Message);
            return false;
        }
      }
      ]]></Code>
    </Task>
  </UsingTask>
  <UsingTask TaskName="SelectNonemptyTestProjects" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestDirectory ParameterType="System.String" Required="true" />
      <ProjectList ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Runtime.Serialization.Json" />
      <Using Namespace="System.Xml" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Method" Language="cs"><![CDATA[
      public override bool Execute()
      {
        var selected = new List<string>();
        foreach (var file in Directory.GetFiles(ManifestDirectory, "*.json").OrderBy(path => path, StringComparer.Ordinal))
        {
            using (var stream = File.OpenRead(file))
            using (var reader = JsonReaderWriterFactory.CreateJsonReader(stream, XmlDictionaryReaderQuotas.Max))
            {
                var document = XDocument.Load(reader);
                var properties = document.Root.Element("Properties");
                var name = properties.Element("AssemblyName").Value;
                if (!name.EndsWith(".Tests", StringComparison.Ordinal)) continue;
                var projectPath = properties.Element("MSBuildProjectFullPath").Value;
                var compileItems = document.Root.Element("Items").Element("Compile").Elements();
                if (!compileItems.Any())
                    Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High, name + ": EMPTY scaffold; no unit-test coverage claimed.");
                else selected.Add(projectPath);
            }
        }
        File.WriteAllLines(ProjectList, selected);
        return true;
      }
      ]]></Code>
    </Task>
  </UsingTask>
  <UsingTask TaskName="ValidateKafkaMappingCoverage" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <CoverageReport ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Xml" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Method" Language="cs"><![CDATA[
      public override bool Execute()
      {
        try
        {
            var settings = new XmlReaderSettings { DtdProcessing = DtdProcessing.Prohibit, XmlResolver = null };
            XDocument document;
            using (var reader = XmlReader.Create(CoverageReport, settings)) document = XDocument.Load(reader);
            if (document.Root == null || document.Root.Name != "coverage")
                throw new InvalidDataException("Expected a Cobertura coverage report.");
            var packages = document.Root.Descendants("package").Where(package => (string)package.Attribute("name") == "Parchwell.Kafka").ToArray();
            if (packages.Length != 1) throw new InvalidDataException("Expected the instrumented Parchwell.Kafka assembly.");
            var classes = packages[0].Descendants("class").ToArray();
            var required = new[] { "KafkaConfigurationFactory", "KafkaBaselineOptionsValidator", "KafkaServiceCollectionExtensions", "BaselineSettingsCatalog", "FrozenInventory", "KafkaBaseline<TConfig>", "KafkaBaselineOptions", "KafkaRoleRegistration", "KafkaSettingDefinition", "KafkaSettingMetadata", "KafkaSettingSource" };
            foreach (var name in required)
                if (!classes.Any(type => (string)type.Attribute("name") == "Parchwell.Kafka.Configuration." + name
                    && type.Element("lines") != null && type.Element("lines").Elements("line").Any()))
                    throw new InvalidDataException("Missing coverage for " + name + ".");
            var mappingNames = required.Select(name => "Parchwell.Kafka.Configuration." + name).ToArray();
            classes = classes.Where(type => mappingNames.Any(name =>
                (string)type.Attribute("name") == name
                || ((string)type.Attribute("name") ?? "").StartsWith(name + ".", StringComparison.Ordinal))).ToArray();
            var lines = classes.SelectMany(type => type.Element("lines") == null ? Enumerable.Empty<XElement>() : type.Element("lines").Elements("line")).ToArray();
            if (lines.Length == 0) throw new InvalidDataException("Coverage report contains no mapping lines.");
            foreach (var line in lines)
            {
                int hits;
                if (!int.TryParse((string)line.Attribute("hits"), out hits) || hits <= 0)
                    throw new InvalidDataException("Uncovered or invalid mapping line: " + (string)line.Attribute("number") + ".");
            }
            var sourceLines = classes.SelectMany(type => type.Element("lines") == null ? Enumerable.Empty<string>() : type.Element("lines").Elements("line").Select(line => (string)type.Attribute("filename") + ":" + (string)line.Attribute("number"))).Distinct().Count();
            Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High, "Parchwell.Kafka: " + sourceLines + " instrumented source lines covered; branch completeness is checked by behavioral tests.");
            return true;
        }
        catch (Exception exception)
        {
            Log.LogError("Kafka mapping coverage rejected: " + exception.Message);
            return false;
        }
      }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="ValidateKafkaCoverage">
    <ValidateKafkaMappingCoverage CoverageReport="$(CoverageReport)" />
  </Target>
  <Target Name="ValidateReport">
    <ValidateXunitReport Report="$(Report)" ExpectedAssembly="$(ExpectedAssembly)" />
  </Target>
  <UsingTask TaskName="PublishPhantomSpikeEvidence" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <EvidenceDirectory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Runtime.Serialization.Json" />
      <Using Namespace="System.Xml" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Method" Language="cs"><![CDATA[
      public override bool Execute()
      {
        try
        {
            if (!Directory.Exists(EvidenceDirectory)) throw new InvalidDataException("Missing spike evidence directory.");
            var experiments = Directory.GetFiles(EvidenceDirectory, "experiment.json", SearchOption.AllDirectories);
            if (experiments.Length != 1) throw new InvalidDataException("Expected exactly one spike experiment record.");
            var directory = Path.GetDirectoryName(experiments[0]);
            foreach (var name in new[] { "experiment.json", "decision.json", "trial-records.json" })
            {
                var path = Path.Combine(directory, name);
                if (!File.Exists(path)) throw new InvalidDataException("Missing spike record: " + name);
                using (var stream = File.OpenRead(path))
                using (var reader = JsonReaderWriterFactory.CreateJsonReader(stream, XmlDictionaryReaderQuotas.Max))
                {
                    reader.MoveToContent();
                    if (reader.NodeType != XmlNodeType.Element || reader.GetAttribute("type") != "object")
                        throw new InvalidDataException("Invalid spike record root: " + name);
                    if (name == "decision.json")
                    {
                        var document = XDocument.Load(reader);
                        var finding = document.Root.Element("ExistenceFinding");
                        if (finding == null || (finding.Value != "yes" && finding.Value != "no" && finding.Value != "inconclusive"))
                            throw new InvalidDataException("Missing or invalid spike finding.");
                    }
                    else
                    {
                        // Validate large raw traces without materializing their XML string values.
                        while (reader.Read()) { }
                    }
                }
                if (name != "experiment.json")
                    Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High, name + ":\n" + File.ReadAllText(path));
            }
            Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High, "Full local spike evidence: " + directory);
            return true;
        }
        catch (Exception exception)
        {
            Log.LogError("Spike evidence rejected: " + exception.Message);
            return false;
        }
      }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="PublishSpikeEvidence">
    <PublishPhantomSpikeEvidence EvidenceDirectory="$(EvidenceDirectory)" />
  </Target>
  <Target Name="SelectTests">
    <SelectNonemptyTestProjects ManifestDirectory="$(ManifestDirectory)" ProjectList="$(ProjectList)" />
  </Target>
</Project>
