<?xml version="1.0" encoding="utf-8"?>
<!-- https://github.com/microsoft/codecoverage/blob/8df391ed291de6ae26bf688b6e591961ab5698cd/docs/configuration.md -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[/\\]Parchwell\.Kafka\.dll$</ModulePath>
      </Include>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
