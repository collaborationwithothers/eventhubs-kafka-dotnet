{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "configuration_id",
    "runtime"
  ],
  "properties": {
    "scenario_id": {
      "enum": [
        "A01",
        "B04",
        "B01",
        "B03",
        "B05",
        "C08",
        "C12",
        "F04",
        "B08",
        "E01",
        "F06"
      ]
    },
    "configuration_id": {
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6",
        "C7",
        "C8",
        "C9",
        "C10",
        "C11"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "phase",
        "mode",
        "source_commit",
        "loadgen_image",
        "verifier_image",
        "service_accounts",
        "eventhubs",
        "blob",
        "eventhubs_ip",
        "blob_ip",
        "application_insights_connection_string",
        "bounds"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "minLength": 1,
          "maxLength": 29
        },
        "phase": {
          "enum": [
            "probe",
            "C0",
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "C7",
            "C8",
            "C9",
            "C10",
            "C11"
          ]
        },
        "mode": {
          "enum": [
            "start-line",
            "loadgen",
            "verify",
            "judge",
            "single-action",
            "single-action-judge",
            "single-action-seed",
            "single-action-v2",
            "single-action-v2-judge"
          ]
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "loadgen_job_name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "minLength": 1,
          "maxLength": 49
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "loadgen_image": {
          "type": "string",
          "pattern": "^[^/ ]+/parchwell/loadgen@sha256:[a-f0-9]{64}$"
        },
        "verifier_image": {
          "type": "string",
          "pattern": "^[^/ ]+/parchwell/verifier@sha256:[a-f0-9]{64}$"
        },
        "service_accounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "loadgen",
            "verifier"
          ],
          "properties": {
            "loadgen": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "client_id"
              ],
              "properties": {
                "name": {
                  "const": "loadgen"
                },
                "client_id": {
                  "type": "string",
                  "pattern": "\\S",
                  "minLength": 1
                },
                "subject": {
                  "type": "string",
                  "const": "system:serviceaccount:parchwell:loadgen"
                }
              }
            },
            "verifier": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "client_id"
              ],
              "properties": {
                "name": {
                  "const": "verifier"
                },
                "client_id": {
                  "type": "string",
                  "pattern": "\\S",
                  "minLength": 1
                },
                "subject": {
                  "type": "string",
                  "const": "system:serviceaccount:parchwell:verifier"
                }
              }
            },
            "probe": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "client_id"
              ],
              "properties": {
                "name": {
                  "const": "probe"
                },
                "client_id": {
                  "type": "string",
                  "pattern": "\\S",
                  "minLength": 1
                },
                "subject": {
                  "type": "string",
                  "const": "system:serviceaccount:parchwell:probe"
                }
              }
            },
            "enrichment-consumer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "client_id"
              ],
              "properties": {
                "name": {
                  "const": "enrichment-consumer"
                },
                "client_id": {
                  "type": "string",
                  "pattern": "\\S",
                  "minLength": 1
                },
                "subject": {
                  "type": "string",
                  "const": "system:serviceaccount:parchwell:enrichment-consumer"
                }
              }
            }
          }
        },
        "eventhubs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace_name",
            "bootstrap_servers",
            "topics"
          ],
          "properties": {
            "namespace_name": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            },
            "bootstrap_servers": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?\\.servicebus\\.windows\\.net:9093$"
            },
            "topics": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "events",
                "state",
                "dlq"
              ],
              "properties": {
                "events": {
                  "const": "document-events"
                },
                "state": {
                  "const": "document-state"
                },
                "dlq": {
                  "const": "document-events-dlq"
                }
              }
            }
          }
        },
        "blob": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_url",
            "containers"
          ],
          "properties": {
            "account_url": {
              "type": "string",
              "pattern": "^https://[A-Za-z0-9.-]+/?$"
            },
            "containers": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ledger",
                "verifier",
                "claim_check"
              ],
              "properties": {
                "ledger": {
                  "const": "ledger"
                },
                "verifier": {
                  "const": "verifier"
                },
                "claim_check": {
                  "const": "claim-check"
                },
                "single_action": {
                  "const": "single-action"
                }
              }
            }
          }
        },
        "eventhubs_ip": {
          "type": "string",
          "minLength": 1
        },
        "blob_ip": {
          "type": "string",
          "minLength": 1
        },
        "application_insights_connection_string": {
          "type": "string",
          "pattern": "\\S",
          "minLength": 1
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scenario_parsing",
            "loadgen",
            "verifier_shared",
            "verifier_kafka",
            "verifier_start_line",
            "verifier_verify",
            "verifier_gate",
            "execution",
            "single_action_execution",
            "single_action_capture",
            "single_action_judge"
          ],
          "properties": {
            "scenario_parsing": {
              "type": "object",
              "const": {
                "MaxDocumentCharacters": 1048576,
                "MaxNestingDepth": 32,
                "MaxScalarCharacters": 65536,
                "MaxParserEvents": 100000
              }
            },
            "loadgen": {
              "type": "object",
              "const": {
                "MaxAttempts": 186000,
                "MaxPayloadBytes": 900000,
                "MaxRowBytes": 16384,
                "MaxManifestBytes": 67108864,
                "MaxLedgerBytes": 268435456,
                "MaxLedgerReadbackBytes": 268435456,
                "LedgerQueueCapacity": 8192,
                "EvidenceQueueCapacity": 2048,
                "MaxReportBytes": 1048576,
                "MaxSnapshotCharacters": 1048576,
                "MaxEvidenceFileBytes": 134217728,
                "MaxDiagnostics": 100,
                "MaxBrokerSeries": 64,
                "MaxArtifactBytes": 268435456,
                "MaxAggregateArtifactBytes": 1073741824,
                "MaxScheduleLateness": "00:00:01",
                "ProducerDrainTimeout": "00:05:00",
                "LedgerDrainTimeout": "00:00:10",
                "EvidenceCompletionTimeout": "00:00:20",
                "StatisticsCompletionTimeout": "00:00:20",
                "UploadTimeout": "00:00:30",
                "CleanupTimeout": "00:00:10",
                "ProcessLifetimeTimeout": "00:15:00",
                "RequireStatisticsEvidence": true,
                "RequireRequestEvidence": false,
                "ScenarioSourceRoot": "/app",
                "OutputRoot": "/work/loadgen",
                "EnrichmentGroupId": "a01-unused-enrichment"
              }
            },
            "verifier_shared": {
              "type": "object",
              "const": {
                "MaxOutputBytes": 16777216,
                "MaxDiagnosticsPerCheck": 100,
                "MaxDiagnosticBytes": 2048,
                "CleanupTimeout": "00:00:10",
                "IoTimeout": "00:00:10",
                "MaxInputDepth": 32
              }
            },
            "verifier_kafka": {
              "type": "object",
              "const": {
                "TokenTimeout": "00:00:10",
                "MetadataTimeout": "00:00:10",
                "WatermarkTimeout": "00:00:10",
                "PollSlice": "00:00:00.100",
                "BlobIoTimeout": "00:00:30",
                "MaxPartitions": 32,
                "ScenarioRoot": "/app"
              }
            },
            "verifier_start_line": {
              "type": "object",
              "const": {
                "ProcessLifetime": "00:02:00"
              }
            },
            "verifier_verify": {
              "type": "object",
              "const": {
                "ProcessLifetime": "00:12:00",
                "SafetyStop": "00:10:00",
                "MaxConsumedRecords": 372000,
                "MaxConsumedBytes": 17179869184,
                "MaxArtifactBytes": 268435456,
                "MaxTotalInputBytes": 1073741824,
                "MaxRowBytes": 16777216,
                "MaxRowsPerArtifact": 372000,
                "MaxInventoryEntries": 186000,
                "MaxInputEntries": 4194304,
                "MaxNativeReportBytes": 1048576,
                "MaxBrokerEntries": 64
              }
            },
            "verifier_gate": {
              "type": "object",
              "const": {
                "ProcessLifetime": "00:01:00",
                "MaxArtifactBytes": 16777216,
                "MaxTotalInputBytes": 83886080,
                "ScenarioRoot": "/app"
              }
            },
            "execution": {
              "type": "object",
              "const": {
                "loadgen_job_seconds": 1140,
                "verify_job_seconds": 750,
                "start_line_job_seconds": 150,
                "gate_job_seconds": 90,
                "termination_grace_seconds": 30
              }
            },
            "single_action_execution": {
              "type": "object",
              "const": {
                "action_job_seconds": 1980,
                "judge_job_seconds": 120,
                "termination_grace_seconds": 30,
                "seed_job_seconds": 420
              }
            },
            "single_action_capture": {
              "type": "object",
              "const": {
                "ProcessLifetimeSeconds": 1920,
                "PostTerminalStatisticsSeconds": 20,
                "CleanupSeconds": 10,
                "RegistrationUploadSeconds": 30,
                "CaptureUploadSeconds": 30,
                "HostCleanupSeconds": 10,
                "ReceiptUploadSeconds": 30,
                "PollSliceMs": 100,
                "MaxCaptureBytes": 134217728,
                "MaxRegistrationBytes": 65536,
                "MaxCompletionBytes": 65536,
                "MaxStatisticsReportBytes": 262144,
                "MaxStatisticsReports": 64,
                "MaxClientErrors": 64,
                "MaxErrorBytes": 4096,
                "MaxDiagnostics": 100,
                "MaxDiagnosticBytes": 2048,
                "CallbackQueueCapacity": 128,
                "MaxSettingsKeys": 128,
                "MaxSettingsBytes": 16384,
                "MaxNonmatchingRecords": 4096,
                "MaxInputDepth": 32
              }
            },
            "single_action_judge": {
              "type": "object",
              "const": {
                "MaxCaptureBytes": 134217728,
                "MaxRegistrationBytes": 65536,
                "MaxCompletionBytes": 65536,
                "MaxSeedReceiptBytes": 65536,
                "MaxSeedPodBytes": 65536,
                "MaxCandidateBytes": 16777216,
                "MaxTotalInputBytes": 268435456,
                "MaxInputDepth": 32,
                "MaxSettingsKeys": 128,
                "MaxSettingsBytes": 16384,
                "MaxErrorBytes": 4096,
                "MaxDiagnosticBytes": 2048,
                "MaxDiagnostics": 100,
                "MaxClientErrors": 64,
                "MaxStatisticsReports": 64,
                "MaxStatisticsReportBytes": 262144,
                "CallbackQueueCapacity": 128,
                "MaxBrokerEntries": 64,
                "MaxMatchedValueBytes": 1100000,
                "MaxNonmatchingRecords": 4096,
                "ProcessLifetimeSeconds": 90,
                "IoSeconds": 10,
                "CleanupSeconds": 10
              }
            },
            "probe_v2": {
              "type": "object",
              "const": {
                "capture": {
                  "PostTerminalStatisticsSeconds": 20,
                  "CleanupSeconds": 10,
                  "HostCleanupSeconds": 10,
                  "IoSeconds": 10,
                  "PollSliceMs": 100,
                  "MetadataTimeoutMs": 60000,
                  "MaxCaptureBytes": 2097152,
                  "MaxRegistrationBytes": 65536,
                  "MaxPodBytes": 65536,
                  "MaxStatisticsReportBytes": 262144,
                  "MaxStatisticsReports": 1,
                  "MaxClientErrors": 8,
                  "MaxErrorBytes": 1024,
                  "MaxDiagnostics": 100,
                  "MaxDiagnosticBytes": 2048,
                  "CallbackQueueCapacity": 128,
                  "MaxSettingsKeys": 128,
                  "MaxSettingsBytes": 16384,
                  "MaxNonmatchingRecords": 4096,
                  "MaxInputDepth": 32,
                  "MaxKeyBytes": 4096,
                  "MaxValueBytes": 4096,
                  "MaxClientLogBytes": 16384
                },
                "judge": {
                  "ProcessLifetimeSeconds": 90,
                  "IoSeconds": 10,
                  "CleanupSeconds": 10,
                  "MaxCandidateBytes": 16777216,
                  "MaxJudgeReceiptBytes": 65536,
                  "MaxTotalInputBytes": 268435456,
                  "MaxInputFiles": 256,
                  "MaxBrokerEntries": 64,
                  "MaxRoleScopeBytes": 131072,
                  "MaxEffectiveScopeBytes": 32768
                },
                "execution": {
                  "producer_process_seconds": 1920,
                  "producer_job_seconds": 1980,
                  "reader_process_seconds": 840,
                  "reader_job_seconds": 900,
                  "judge_job_seconds": 120,
                  "termination_grace_seconds": 30,
                  "collection_seconds_per_stage": 120,
                  "admission_seconds": 14400,
                  "max_container_log_bytes": 4194304
                },
                "parsing": {
                  "MaxDocumentCharacters": 1048576,
                  "MaxNestingDepth": 32,
                  "MaxScalarCharacters": 65536,
                  "MaxParserEvents": 100000
                }
              }
            }
          }
        },
        "action_role": {
          "enum": [
            "loadgen",
            "probe",
            "enrichment-consumer",
            "verifier"
          ]
        },
        "image_smoke": {
          "type": "boolean"
        },
        "enrichment_image": {
          "type": "string",
          "pattern": "^[^/ ]+/parchwell/enrichment@sha256:[a-f0-9]{64}$"
        },
        "seed_receipt_configmap": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?-f04-seed-receipt$"
        },
        "stage": {
          "enum": [
            "seed",
            "seedread",
            "action",
            "read",
            "judge"
          ]
        },
        "probe_namespace_data_roles": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "single-action-v2",
                  "single-action-v2-judge"
                ]
              }
            }
          },
          "then": {
            "required": [
              "action_role",
              "image_smoke",
              "stage",
              "probe_namespace_data_roles"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "repeat"
                  ]
                },
                {
                  "required": [
                    "loadgen_job_name"
                  ]
                },
                {
                  "required": [
                    "enrichment_image"
                  ]
                },
                {
                  "required": [
                    "seed_receipt_configmap"
                  ]
                }
              ]
            },
            "properties": {
              "bounds": {
                "required": [
                  "probe_v2"
                ]
              },
              "service_accounts": {
                "required": [
                  "loadgen",
                  "verifier",
                  "probe",
                  "enrichment-consumer"
                ],
                "properties": {
                  "loadgen": {
                    "required": [
                      "name",
                      "client_id",
                      "subject"
                    ]
                  },
                  "verifier": {
                    "required": [
                      "name",
                      "client_id",
                      "subject"
                    ]
                  },
                  "probe": {
                    "required": [
                      "name",
                      "client_id",
                      "subject"
                    ]
                  },
                  "enrichment-consumer": {
                    "required": [
                      "name",
                      "client_id",
                      "subject"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "judge"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "repeat"
                        ]
                      },
                      {
                        "required": [
                          "loadgen_job_name"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "mode": {
                      "enum": [
                        "start-line",
                        "loadgen",
                        "verify"
                      ]
                    }
                  },
                  "required": [
                    "mode"
                  ]
                },
                "then": {
                  "required": [
                    "repeat",
                    "loadgen_job_name"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "mode": {
                      "enum": [
                        "single-action",
                        "single-action-judge",
                        "single-action-seed"
                      ]
                    }
                  },
                  "required": [
                    "mode"
                  ]
                },
                "then": {
                  "required": [
                    "action_role",
                    "image_smoke",
                    "enrichment_image"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "repeat"
                        ]
                      },
                      {
                        "required": [
                          "loadgen_job_name"
                        ]
                      }
                    ]
                  },
                  "properties": {
                    "service_accounts": {
                      "required": [
                        "loadgen",
                        "verifier",
                        "probe",
                        "enrichment-consumer"
                      ]
                    },
                    "blob": {
                      "properties": {
                        "containers": {
                          "required": [
                            "single_action"
                          ]
                        }
                      }
                    }
                  }
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "action_role"
                        ]
                      },
                      {
                        "required": [
                          "image_smoke"
                        ]
                      }
                    ]
                  },
                  "properties": {
                    "service_accounts": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "probe"
                            ]
                          },
                          {
                            "required": [
                              "enrichment-consumer"
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "stage"
                      ]
                    },
                    {
                      "required": [
                        "probe_namespace_data_roles"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "mode": {
                "enum": [
                  "single-action-v2",
                  "single-action-v2-judge"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "scenario_id": {
            "enum": [
              "B08",
              "E01",
              "F06"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "scenario_id": {
                  "enum": [
                    "B08",
                    "E01"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "configuration_id": {
                  "enum": [
                    "C0",
                    "C1"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "scenario_id": {
                  "enum": [
                    "E01",
                    "F06"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "runtime": {
                  "properties": {
                    "probe_namespace_data_roles": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "else": {
        "allOf": [
          {
            "if": {
              "properties": {
                "runtime": {
                  "properties": {
                    "mode": {
                      "enum": [
                        "single-action",
                        "single-action-judge",
                        "single-action-seed"
                      ]
                    }
                  },
                  "required": [
                    "mode"
                  ]
                }
              },
              "required": [
                "runtime"
              ]
            },
            "then": {
              "properties": {
                "scenario_id": {
                  "enum": [
                    "B01",
                    "B03",
                    "B05",
                    "C08",
                    "C12",
                    "F04"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "scenario_id": {
                  "enum": [
                    "A01",
                    "B04"
                  ]
                },
                "configuration_id": {
                  "enum": [
                    "C0",
                    "C1",
                    "C3"
                  ]
                },
                "runtime": {
                  "properties": {
                    "phase": {
                      "enum": [
                        "probe",
                        "C0",
                        "C1",
                        "C3"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
