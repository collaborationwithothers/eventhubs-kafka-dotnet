{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "contract_version",
    "scenario_id",
    "configuration_id",
    "profile",
    "kafka",
    "runtime"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 1
    },
    "scenario_id": {
      "const": "A01"
    },
    "configuration_id": {
      "enum": [
        "C0",
        "C3"
      ]
    },
    "profile": {
      "type": "object",
      "minProperties": 1
    },
    "kafka": {
      "type": "object",
      "minProperties": 2
    },
    "runtime": {
      "type": "object",
      "required": [
        "mode",
        "run_id",
        "phase",
        "source_commit",
        "service_accounts",
        "loadgen_image",
        "verifier_image",
        "loadgen_generated_values",
        "verifier_generated_values",
        "loadgen_generated_sha256",
        "verifier_generated_sha256",
        "loadgen_environment",
        "verifier_environment",
        "eventhubs_ip",
        "blob_ip",
        "service_tags",
        "admission_name",
        "job_deadline_seconds",
        "definition_sha256",
        "profile_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "probe",
            "C0",
            "C3"
          ]
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "loadgen_image": {
          "type": "string",
          "pattern": "^[^/ ]+/parchwell/loadgen@sha256:[a-f0-9]{64}$"
        },
        "verifier_image": {
          "type": "string",
          "pattern": "^[^/ ]+/parchwell/verifier@sha256:[a-f0-9]{64}$"
        },
        "loadgen_generated_values": {
          "type": "string",
          "minLength": 1
        },
        "verifier_generated_values": {
          "type": "string",
          "minLength": 1
        },
        "loadgen_generated_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verifier_generated_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "eventhubs_ip": {
          "type": "string",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"
        },
        "blob_ip": {
          "type": "string",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"
        },
        "admission_name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "loadgen",
            "start-line",
            "verify"
          ]
        },
        "service_accounts": {
          "type": "object",
          "required": [
            "loadgen",
            "verifier"
          ],
          "additionalProperties": false,
          "properties": {
            "loadgen": {
              "type": "object",
              "required": [
                "name",
                "client_id"
              ],
              "properties": {
                "name": {
                  "const": "loadgen"
                },
                "client_id": {
                  "type": "string",
                  "minLength": 1
                },
                "subject": {
                  "type": "string"
                }
              }
            },
            "verifier": {
              "type": "object",
              "required": [
                "name",
                "client_id"
              ],
              "properties": {
                "name": {
                  "const": "verifier"
                },
                "client_id": {
                  "type": "string",
                  "minLength": 1
                },
                "subject": {
                  "type": "string"
                }
              }
            }
          }
        },
        "loadgen_environment": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "verifier_environment": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "service_tags": {
          "type": "object",
          "required": [
            "schema_version",
            "source_url",
            "retrieved_utc",
            "source_sha256",
            "change_number",
            "tags"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://download\\.microsoft\\.com/"
            },
            "retrieved_utc": {
              "type": "string",
              "minLength": 1
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "change_number": {
              "type": "integer",
              "minimum": 0
            },
            "tags": {
              "type": "object",
              "required": [
                "AzureActiveDirectory",
                "AzureMonitor"
              ],
              "additionalProperties": false,
              "properties": {
                "AzureActiveDirectory": {
                  "type": "object",
                  "required": [
                    "change_number",
                    "address_prefixes"
                  ],
                  "properties": {
                    "change_number": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "address_prefixes": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4096,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F:.]+/[1-9][0-9]*$"
                      }
                    }
                  }
                },
                "AzureMonitor": {
                  "type": "object",
                  "required": [
                    "change_number",
                    "address_prefixes"
                  ],
                  "properties": {
                    "change_number": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "address_prefixes": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4096,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F:.]+/[1-9][0-9]*$"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "job_deadline_seconds": {
          "enum": [
            840,
            150,
            750
          ]
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
