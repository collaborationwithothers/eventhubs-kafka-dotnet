{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobName",
    "image",
    "activeDeadlineSeconds"
  ],
  "properties": {
    "jobName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "activeDeadlineSeconds": {
      "type": "integer",
      "const": 120
    }
  }
}
