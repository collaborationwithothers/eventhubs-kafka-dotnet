// Corroborating only. Runner prepends JSON-escaped private start/end/resource bindings.
// Columns verified 2026-10-22 against MicrosoftDocs/azure-monitor-docs:
// https://github.com/MicrosoftDocs/azure-monitor-docs/blob/6c8e97c9e8b8e57c19e3b319bda5188e4ceba029/
// articles/azure-monitor/reference/tables/azmskafkausererrorlogs.md and
// articles/azure-monitor/reference/tables/azmsdiagnosticerrorlogs.md.
union
    (AZMSKafkaUserErrorLogs
        | where TimeGenerated >= start_utc and TimeGenerated <= end_utc
        | where _ResourceId == resource_id
        | project TimeGenerated, SourceTable="AZMSKafkaUserErrorLogs", Detail=Message, ObservedErrorCount=1),
    (AZMSDiagnosticErrorLogs
        | where TimeGenerated >= start_utc and TimeGenerated <= end_utc
        | where _ResourceId == resource_id
        | project TimeGenerated, SourceTable="AZMSDiagnosticErrorLogs", Detail=ErrorMessage, ObservedErrorCount=ErrorCount)
| summarize ObservedRows=count(), ErrorCount=sum(ObservedErrorCount) by SourceTable, Detail=substring(Detail, 0, 2048)
| take 10001
